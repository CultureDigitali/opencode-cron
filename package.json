{
  "name": "@culturedigitali/opencode-cron",
  "version": "1.2.1",
  "description": "ChatGPT Scheduled Tasks for opencode - session-bound cron + persistent memory for AI agents",
  "license": "MIT",
  "author": "opencode-cron contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CultureDigitali/opencode-cron.git"
  },
  "homepage": "https://github.com/CultureDigitali/opencode-cron#readme",
  "bugs": {
    "url": "https://github.com/CultureDigitali/opencode-cron/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-cron",
    "cron",
    "scheduler",
    "scheduled-tasks",
    "chatgpt-scheduled-tasks",
    "ai-agent",
    "ai-agents",
    "ai-agent-scheduler",
    "llm-agents",
    "coding-agent",
    "automation",
    "ai-automation",
    "background-tasks",
    "recurring-tasks",
    "background-jobs",
    "persistent-memory",
    "session-memory",
    "session-cron",
    "crontab",
    "systemd",
    "launchd"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "import": "./dist/schedule.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "import": "./dist/notifications.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    },
    "./backup": {
      "types": "./dist/backup.d.ts",
      "import": "./dist/backup.js"
    },
    "./dlq": {
      "types": "./dist/dlq.d.ts",
      "import": "./dist/dlq.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "import": "./dist/pipeline.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js"
    },
    "./concurrency": {
      "types": "./dist/concurrency.d.ts",
      "import": "./dist/concurrency.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "import": "./dist/redact.js"
    }
  },
  "bin": {
    "opencode-cron": "./dist/bin/run.js",
    "opencode-cron-run": "./dist/bin/run.js"
  },
  "files": [
    "dist",
    "src",
    "commands",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:lib && bun run build:bin && bun run build:types",
    "build:lib": "bun build src/*.ts src/gui/server.ts src/desktop/main.ts --outdir dist --root src --target node --format esm --packages external",
    "build:bin": "bun build bin/run.ts --outdir dist/bin --target node --format esm --packages external && head -1 dist/bin/run.js | grep -q '#!/usr/bin/env node' || { printf '#!/usr/bin/env node\\n%s' \"$(cat dist/bin/run.js)\" > dist/bin/run.js.tmp && mv dist/bin/run.js.tmp dist/bin/run.js; } && chmod +x dist/bin/run.js",
    "build:types": "tsc -p tsconfig.build.json",
    "gui": "bun src/gui/server.ts",
    "desktop": "bun run build:lib && electron dist/desktop/main.js",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:all": "bun run build && electron-builder -mwl",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.0",
    "cron-parser": "^4.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "1.2.0",
    "@types/node": "^20.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "publint": "^0.2.0",
    "typescript": "^5.6.0"
  }
}
